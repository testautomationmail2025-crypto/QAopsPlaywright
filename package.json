  "main": "index.js",
  "scripts": {
    "test": " npx playwright test --grep @web",
    "test:allure": "rimraf allure-results allure-report & playwright test tests/assertion.spec.js & allure generate ./allure-results --clean ./allure-report",
    "report:open": "rimraf allure-results allure-report & playwright test tests/assertion.spec.js & allure generate ./allure-results --clean & allure open ./allure-report",
    "cucumber": "npx cucumber-js features/eCommerce.feature --exit",
    "cucumberRegression": "npx cucumber-js --tags @regression --retry 1 --exit ",
    "cucumberReport": "npx cucumber-js features/errorValidations.feature --parallel 2 --exit --format html:cucumber-report.html"
  },
